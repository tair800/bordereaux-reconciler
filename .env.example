# Copy to .env and edit. `.env` is gitignored and must never be committed.
#
# Everything here has a safe default. The two that matter both fail closed, so an instance that
# sets none of this serves the console and cannot be written to.

# The database. The default points at the docker-compose service on a high local port.
BX_DATABASE_URL=postgresql+psycopg://bordereaux:change_me_locally@127.0.0.1:15437/bordereaux

# Read-only unless explicitly disabled. Leave this true for anything public: confirming a mapping
# changes how a coverholder's premium is read, and that is not something an anonymous visitor does.
BX_READ_ONLY=true

# No default, deliberately. When it is unset the write endpoints reject everything, so there is no
# token to guess. Set it only on an instance that should be able to approve a mapping, and generate
# it with `python -c "import secrets; print(secrets.token_urlsafe(32))"` rather than by hand.
BX_APPROVER_TOKEN=

# Shown in the console header so a reader knows which instance they are looking at.
BX_ENVIRONMENT=local

# Where the generated corpus and the built evidence live. Both are relative to the repository root.
BX_CORPUS_DIR=data/generated
BX_ARTIFACTS_DIR=artifacts

# ---------------------------------------------------------------------------------------------
# Inference. No live arm is wired in this build: the provider port and the residency record are
# built and tested, and the HTTP call is the part that needs a key this build does not have.
# Setting a key does not enable anything yet, and the README publishes no cost or latency figure
# for an arm that has never been called.
# ---------------------------------------------------------------------------------------------
BX_HOSTED_API_KEY=
BX_HOSTED_API_REGION=eu-west
